<% const cards = [['Total Aset', stats.total, 'bi-box-seam', 'blue'], ['Tersedia', stats.tersedia, 'bi-check-circle', 'green'], ['Sedang Dipinjam', stats.dipinjam, 'bi-arrow-left-right', 'violet'], ['Dalam Perbaikan', stats.perbaikan, 'bi-tools', 'amber'], ['Terlambat', stats.terlambat, 'bi-exclamation-triangle', 'red']]; %>
<div class="row g-3 mb-4">
  <% cards.forEach(c => { %><div class="col-6 col-md-4 col-xl"><div class="stat-card"><span class="stat-ico t-<%= c[3] %>"><i class="bi <%= c[2] %>"></i></span><div><div class="stat-num"><%= c[1] %></div><div class="stat-lbl"><%= c[0] %></div></div></div></div><% }) %>
</div>
<div class="row g-3 mb-4">
  <div class="col-lg-7"><div class="panel h-100"><h3>Peminjaman 6 bulan terakhir</h3><div class="chart-box"><canvas id="chartBulan"></canvas></div></div></div>
  <div class="col-lg-5"><div class="panel h-100"><h3>Aset per kategori</h3><div class="chart-box"><canvas id="chartKategori"></canvas></div></div></div>
</div>
<div class="row g-3">
  <div class="col-lg-7"><div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-2"><h3 class="mb-0">Peminjaman aktif</h3><a href="/peminjaman?status=Dipinjam" class="small">Lihat semua</a></div>
    <% if (!aktif.length) { %><p class="empty">Tidak ada aset yang sedang dipinjam.</p><% } else { %>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Aset</th><th>Peminjam</th><th>Batas kembali</th></tr></thead><tbody>
      <% aktif.forEach(l => { const late = l.tgl_rencana_kembali < new Date().toISOString().slice(0,10); %>
      <tr><td><b><%= l.aset %></b><div class="small text-muted"><%= l.kode %></div></td><td><%= l.peminjam %></td><td><%= fmtDate(l.tgl_rencana_kembali) %> <%- late ? badge('Terlambat') : '' %></td></tr><% }) %>
    </tbody></table></div><% } %>
  </div></div>
  <div class="col-lg-5">
    <div class="panel mb-3"><h3>Kondisi aset</h3>
      <% const tot = kondisi.reduce((s, k) => s + k.n, 0) || 1; kondisi.forEach(k => { const tone = {Baik:'green','Rusak Ringan':'amber','Rusak Berat':'red'}[k.label] || 'blue'; %>
      <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span><%= k.label %></span><b><%= k.n %></b></div><div class="progress"><div class="progress-bar bar-<%= tone %>" style="width: <%= Math.round(k.n / tot * 100) %>%"></div></div></div><% }) %>
    </div>
    <div class="panel"><h3>Aktivitas terbaru</h3>
      <% if (!logs.length) { %><p class="empty">Belum ada aktivitas.</p><% } %>
      <ul class="feed"><% logs.forEach(g => { %><li><b><%= g.aksi %></b> <span class="text-muted"><%= g.detail %></span><small><%= g.nama || 'Sistem' %> &middot; <%= fmtDateTime(g.created_at) %></small></li><% }) %></ul>
    </div>
  </div>
</div>
<script type="application/json" id="dash-data"><%- chartData %></script>
<script src="/js/dashboard.js"></script>
