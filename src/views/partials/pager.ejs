<% if (pager.pages > 1) { const link = p => '?' + (qs ? qs + '&' : '') + 'page=' + p; %>
<nav class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
  <small class="text-muted">Halaman <%= pager.page %> dari <%= pager.pages %> (<%= pager.total %> data)</small>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= pager.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= link(pager.page - 1) %>">&laquo;</a></li>
    <% for (let p = Math.max(1, pager.page - 2); p <= Math.min(pager.pages, pager.page + 2); p++) { %><li class="page-item <%= p === pager.page ? 'active' : '' %>"><a class="page-link" href="<%= link(p) %>"><%= p %></a></li><% } %>
    <li class="page-item <%= pager.page >= pager.pages ? 'disabled' : '' %>"><a class="page-link" href="<%= link(pager.page + 1) %>">&raquo;</a></li>
  </ul>
</nav><% } %>
